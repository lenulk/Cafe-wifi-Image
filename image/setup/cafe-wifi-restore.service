[Unit]
Description=Cafe-WiFi setup: restore keys + database from backup (USB)
ConditionPathExists=!/etc/cafe-wifi/.site-done
After=mariadb.service
Requires=mariadb.service

[Service]
Type=oneshot
WorkingDirectory=/opt/cafe-wifi
Environment=PYTHONPATH=/opt/cafe-wifi
ExecStart=/opt/cafe-wifi/venv/bin/python -m setup.restore
RuntimeDirectory=cafe-wifi-apply
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
TimeoutStartSec=40min
